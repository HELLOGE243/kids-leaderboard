rules_version = '2';

// ============================================================
// CleverSpace Firestore security rules
//
// Identity comes from Firebase Auth custom tokens minted by the authLogin /
// authResetPassword functions after they verify credentials server-side.
// request.auth.uid is the student or teacher id; request.auth.token.role is
// 'student' or 'teacher'.
//
// The Admin SDK (Cloud Functions) bypasses these rules entirely, so the
// aggregation trigger can still maintain leaderboards and quizStats.
// ============================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isTeacher() {
      return signedIn() && request.auth.token.role == 'teacher';
    }

    // Who runs the platform, as opposed to who teaches on it.
    //
    // Both sign in as teachers; only an admin may change what the platform is
    // made of - the quizzes, the courses, the classes, the shop, the terms and
    // the accounts. A teacher marks, reads their students and answers them.
    // Until now this line existed only in the admin UI hiding its own buttons,
    // which stopped nobody who opened the console.
    function isAdmin() {
      return isTeacher() && request.auth.token.admin == true;
    }

    // A teacher reaches the students in the classes they hold, and no others.
    //
    // The classes are in their token; which class a student is in is read from
    // a document of its own rather than from the student's record. That record
    // is written whole by the student's own browser every time they answer a
    // question, so a field living there would be wiped by an older tab - and a
    // student who worked out what it was for could drop their own class and
    // disappear from their teacher's dashboard. Nobody but an admin writes the
    // mapping, and nothing a student does touches it.
    function classesOf(studentId) {
      return get(/databases/$(database)/documents/studentClasses/$(studentId)).data.classIds;
    }

    function teaches(studentId) {
      return isTeacher()
        && exists(/databases/$(database)/documents/studentClasses/$(studentId))
        && request.auth.token.classIds.hasAny(classesOf(studentId));
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // A parent reads their own children's work and nothing else, ever.
    //
    // The children are in the token, put there when the parent proved control
    // of the email address those students are registered to. Reading them from
    // the token rather than from a document means no extra read on every rule
    // evaluation, and means a parent cannot widen their own access by writing
    // somewhere - there is nothing to write.
    function isParent() {
      return signedIn() && request.auth.token.role == 'parent';
    }

    function isParentOf(studentId) {
      return isParent() && studentId in request.auth.token.children;
    }

    // --- Shared app structure -------------------------------------------
    // Everyone signed in reads it (courses, classes, quizzes, shop config).
    // Teachers may change anything. Students may change only the specific
    // fields their own activity produces - enforced per field, and for maps
    // keyed by student id, per entry - so a student cannot edit courses,
    // quizzes, classes, the shop setup, teachers, or another student's record.
    // Mirrored client-side by STUDENT_WRITABLE in src/data/firebase.js.
    function isStudent() {
      return signedIn() && request.auth.token.role == 'student';
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Within map `field`, only the caller's own entry may change.
    function onlyOwnEntry(field) {
      return !changedKeys().hasAny([field])
        || request.resource.data.get(field, {}).diff(resource.data.get(field, {}))
             .affectedKeys().hasOnly([request.auth.uid]);
    }

    function studentMayUpdate(docId) {
      return (docId == 'core'
              && changedKeys().hasOnly(['students', '_savedAt'])
              && onlyOwnEntry('students'))
          || (docId == 'activity'
              && changedKeys().hasOnly(['scores', 'dailyTrivia', 'dailyPuzzles']))
          || (docId == 'shop'
              && changedKeys().hasOnly(['purchases']))
          || (docId == 'extras'
              && changedKeys().hasOnly(['wordleSolvers', 'arenaGhosts', 'dojoClones', 'dojoKills'])
              && onlyOwnEntry('dojoKills'))
          || docId == 'broadcasts';
    }

    // What a teacher writes here is only ever their marking: the marks and
    // annotations on a piece of writing, the reports they have dealt with, and
    // the teaching groups inside their own class. Everything else in these
    // documents - courses, quizzes, classes, students, the shop, the term - is
    // the platform itself, and belongs to an admin.
    function teacherMayUpdate(docId) {
      return docId == 'content'
        && changedKeys().hasOnly(['writingMarks', 'questionReports',
                                  'explanationReports', 'classGroups']);
    }

    match /appData/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
      allow update: if (isStudent() && studentMayUpdate(docId))
                    || (isTeacher() && teacherMayUpdate(docId));
      // "Finished a quiz" messages; the document may not exist yet.
      allow create: if isStudent() && docId == 'broadcasts';
    }

    // --- Quiz content ----------------------------------------------------
    match /quizSets/{setId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // AI explanations generated during review, cached once and then shared:
    // the first student to ask pays for the generation, everyone after reads it.
    // Any signed-in user may add to a set's document, but nobody may delete it,
    // and a teacher can overwrite a bad one.
    match /aiExplanations/{setId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if isAdmin();
    }

    // --- The submission archive -------------------------------------------
    // A written record of every paper as it was handed in, kept apart from the
    // student's own document so that a bad write, a bug or a deletion there
    // cannot take the answers with it. A student writes their own and nobody -
    // teacher included - may change or remove one afterwards.
    match /submissions/{submissionId} {
      // Read by the student it belongs to, their parents, and admins. A
      // teacher reads a paper through the student's own record; the archive is
      // the recovery copy, and keeping it to admins keeps it that way.
      allow read: if isAdmin()
        || (signedIn() && resource.data.studentId == request.auth.uid)
        || isParentOf(resource.data.studentId);
      allow create: if signedIn() && request.resource.data.studentId == request.auth.uid;
      allow update, delete: if false;
    }

    // Work in progress, rewritten every few seconds while a paper is open, so
    // a closed tab or a flat battery does not cost a student their answers.
    match /attemptDrafts/{draftId} {
      allow read: if isAdmin() || (signedIn() && resource.data.studentId == request.auth.uid);
      allow create, update: if signedIn() && request.resource.data.studentId == request.auth.uid;
      allow delete: if isAdmin();
    }

    // --- Per-student work ------------------------------------------------
    // A student may read and write only their own document. Teachers may read
    // and update any student's (awarding tokens, clearing attempts when a quiz
    // is deleted, marking work).
    match /studentData/{studentId} {
      allow read: if isSelf(studentId) || isAdmin() || teaches(studentId) || isParentOf(studentId);
      allow create, update: if isSelf(studentId) || isAdmin() || teaches(studentId);
      // Deleting a record takes a child's whole history with it.
      allow delete: if isAdmin();

      // Where a record goes when it outgrows one document. Firestore refuses a
      // document over 1 MiB, and a student here may be sitting papers for
      // years, so the weight of a record - the answers to each paper, the
      // revision deck, the vocabulary - overflows into these. Same owner, same
      // reach: a student's own, and their teachers'.
      match /parts/{part} {
        allow read: if isSelf(studentId) || isAdmin() || teaches(studentId) || isParentOf(studentId);
        allow write: if isSelf(studentId) || isAdmin() || teaches(studentId);
      }
    }

    // --- Questions a student has asked their teacher ------------------------
    // "Ask my teacher" used to flag a card inside the student's own record,
    // where no teacher ever saw it. A question lives here instead, so the
    // teacher who teaches that child can find it without reading three hundred
    // records, and the answer comes back to the child's dashboard.
    //
    // The classes are written on the question when it is asked, by the student
    // asking: it decides only who can see their own question, so the worst a
    // forged one does is show their work to a teacher who does not teach them.
    match /askedQuestions/{askId} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.studentId == request.auth.uid)
        || (isTeacher() && request.auth.token.classIds.hasAny(resource.data.classIds));
      allow create: if isStudent()
        && request.resource.data.studentId == request.auth.uid
        && request.resource.data.status == 'open'
        && !('answer' in request.resource.data);
      // A teacher answers; the student may only say they have read it.
      allow update: if (isTeacher()
                        && request.auth.token.classIds.hasAny(resource.data.classIds)
                        && changedKeys().hasOnly(['answer', 'status', 'answeredAt']))
                    || (isSelf(resource.data.studentId)
                        && changedKeys().hasOnly(['seenByStudent']));
      allow delete: if isAdmin();
    }

    // --- Which classes a student is in ------------------------------------
    // Written by admins only, and read by the rules above to decide whether a
    // teacher may open a student's work. Kept apart from the student's record
    // precisely so that nothing the student does can change it.
    match /studentClasses/{studentId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // --- Derived aggregates ----------------------------------------------
    // Maintained exclusively by the onStudentDataWrite trigger. Read-only to
    // clients: this is what stops a student writing their own leaderboard
    // score or percentile.
    match /leaderboards/{classId}/entries/{studentId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /quizStats/{quizSetId}/attempts/{studentId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // --- Sign-in sessions (one device per account) ---------------------------
    // Written only by the auth functions; a user may read their own so their
    // device knows when a newer sign-in has replaced it.
    match /sessions/{userId} {
      allow get: if isSelf(userId) || isAdmin();
      allow write: if false;
    }

    // --- Parent notification queue (written only by Cloud Functions) ---------
    match /parentNotifications/{id} {
      allow read: if isAdmin();
    }

    // --- Parent contact details --------------------------------------------
    // Phone numbers and emails of students' parents. Teachers only: these were
    // previously on the shared student records every signed-in user can read.
    // A parent is never given these: the address they signed in with is the
    // only one they need, and the rest belongs to the school.
    match /studentContacts/{studentId} {
      allow read, write: if isAdmin();
      // A student reads only their own family's contact (quiz watermark).
      allow get: if isSelf(studentId);
    }

    // --- Credentials ------------------------------------------------------
    // Password hashes. No client may read or write these under any
    // circumstance; only the auth functions touch them.
    // Which parent has paired with which child. Written only by authParent,
    // after it has checked the code and the student id together; no client
    // reads it, because a parent's children are in their token already.
    match /parentPairings/{emailHash} {
      allow read, write: if false;
    }

    match /credentials/{docId} {
      allow read, write: if false;
    }

    // Anything not matched above is denied by default.
  }
}
