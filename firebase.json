{
  "hosting": [
    {
      "public": "dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, max-age=0"
            }
          ]
        },
        {
          "source": "/assets/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "/api/coach",
          "function": "writingCoach"
        },
        {
          "source": "/api/coach/**",
          "function": "writingCoach"
        },
        {
          "source": "/api/claude/**",
          "function": "claudeProxy"
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "site": "cleverspacev2"
    },
    {
      "site": "avant-oc-selective",
      "public": "site/dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "**/*.@(html|xml|txt)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=300"
            }
          ]
        },
        {
          "source": "**/*.@(css|png|jpg|jpeg|svg|webp|woff2)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=86400"
            }
          ]
        }
      ],
      "cleanUrls": true,
      "trailingSlash": true
    }
  ],
  "functions": {
    "source": "functions",
    "runtime": "nodejs22"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
