{
  "hosting": [
    {
      "public": "dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, max-age=0"
            }
          ]
        },
        {
          "source": "/assets/**",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        }
      ],
      "rewrites": [
        {
          "source": "/api/coach",
          "function": "writingCoach"
        },
        {
          "source": "/api/coach/**",
          "function": "writingCoach"
        },
        {
          "source": "/api/claude/**",
          "function": "claudeProxy"
        },
        {
          "source": "**",
          "destination": "/index.html"
        }
      ],
      "site": "cleverspacev2"
    },
    {
      "site": "avant-oc-selective",
      "public": "site/dist",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "headers": [
        {
          "source": "**/*.@(html|xml|txt)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=300"
            }
          ]
        },
        {
          "source": "**/*.@(css|png|jpg|jpeg|svg|webp|woff2)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=86400"
            }
          ]
        }
      ],
      "cleanUrls": true,
      "trailingSlash": true,
      "redirects": [
        {
          "source": "/shop",
          "destination": "/courses/",
          "type": 301
        },
        {
          "source": "/shop-2",
          "destination": "/courses/",
          "type": 301
        },
        {
          "source": "/theshop",
          "destination": "/courses/",
          "type": 301
        },
        {
          "source": "/course-list",
          "destination": "/courses/",
          "type": 301
        },
        {
          "source": "/academics",
          "destination": "/courses/",
          "type": 301
        },
        {
          "source": "/product/**",
          "destination": "/courses/",
          "type": 301
        },
        {
          "source": "/product-category/**",
          "destination": "/courses/",
          "type": 301
        },
        {
          "source": "/product-tag/**",
          "destination": "/courses/",
          "type": 301
        },
        {
          "source": "/pastresults",
          "destination": "/why/track-record/",
          "type": 301
        },
        {
          "source": "/past-results-honour-roll",
          "destination": "/why/track-record/",
          "type": 301
        },
        {
          "source": "/philosophy",
          "destination": "/why/small-classes/",
          "type": 301
        },
        {
          "source": "/login-avant-academy",
          "destination": "https://cleverspacev2.web.app",
          "type": 301
        },
        {
          "source": "/my-account",
          "destination": "https://cleverspacev2.web.app",
          "type": 301
        },
        {
          "source": "/my-account-2",
          "destination": "https://cleverspacev2.web.app",
          "type": 301
        },
        {
          "source": "/my-account/**",
          "destination": "https://cleverspacev2.web.app",
          "type": 301
        },
        {
          "source": "/dashboard",
          "destination": "https://cleverspacev2.web.app",
          "type": 301
        },
        {
          "source": "/dashboard-2",
          "destination": "https://cleverspacev2.web.app",
          "type": 301
        },
        {
          "source": "/dashboard-2-2",
          "destination": "https://cleverspacev2.web.app",
          "type": 301
        },
        {
          "source": "/student-registration",
          "destination": "https://cleverspacev2.web.app",
          "type": 301
        },
        {
          "source": "/student-registration-2",
          "destination": "https://cleverspacev2.web.app",
          "type": 301
        },
        {
          "source": "/student-registration-2-2",
          "destination": "https://cleverspacev2.web.app",
          "type": 301
        },
        {
          "source": "/instructor-registration",
          "destination": "https://cleverspacev2.web.app",
          "type": 301
        },
        {
          "source": "/instructor-registration-2",
          "destination": "https://cleverspacev2.web.app",
          "type": 301
        },
        {
          "source": "/instructor-registration-2-2",
          "destination": "https://cleverspacev2.web.app",
          "type": 301
        },
        {
          "source": "/cart",
          "destination": "/contact/",
          "type": 301
        },
        {
          "source": "/cart-2",
          "destination": "/contact/",
          "type": 301
        },
        {
          "source": "/checkout",
          "destination": "/contact/",
          "type": 301
        },
        {
          "source": "/checkout-2",
          "destination": "/contact/",
          "type": 301
        },
        {
          "source": "/faqs",
          "destination": "/contact/",
          "type": 301
        },
        {
          "source": "/support",
          "destination": "/contact/",
          "type": 301
        },
        {
          "source": "/news",
          "destination": "/why/explanations/",
          "type": 301
        },
        {
          "source": "/news-blog",
          "destination": "/why/explanations/",
          "type": 301
        },
        {
          "source": "/category/**",
          "destination": "/why/explanations/",
          "type": 301
        },
        {
          "source": "/tag/**",
          "destination": "/why/explanations/",
          "type": 301
        }
      ]
    }
  ],
  "functions": [
    {
      "source": "functions",
      "codebase": "app",
      "runtime": "nodejs22"
    },
    {
      "source": "site/functions",
      "codebase": "marketing",
      "runtime": "nodejs22"
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  }
}
